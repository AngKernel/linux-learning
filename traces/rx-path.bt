#!/usr/bin/env bpftrace
/* 观察：v6.18 各接收阶段的调用次数、单次函数包围时间（微秒）。
 * 运行：sudo /work/traces/run.sh rx-path 15，另一个终端向 guest 打 TCP 流量。
 * 预期：@calls[tcp_v4_rcv]: N；@us[tcp_v4_rcv] 的 log2 直方图。
 * 这不是每包端到端时间：GRO/批处理破坏一包一次对应，函数时间含子调用和中断。
 * cpu + tid + 函数 + 深度区分同一 CPU 的递归；这里只适用于这些不睡眠的阶段。
 * 所有探测点的定义、非 inline 证据见 SOURCES.md；真正能否挂载须在 guest 检查。
 */
BEGIN { printf("READY rx-path\n"); }
interval:s:1 { @seconds = @seconds + 1; if (@seconds >= $1) { exit(); } }
kprobe:vring_interrupt
{
  @calls["vring_interrupt"] = count();
  @depth[cpu, tid, "vring_interrupt"] = @depth[cpu, tid, "vring_interrupt"] + 1;
  @start[cpu, tid, "vring_interrupt", @depth[cpu, tid, "vring_interrupt"]] = nsecs;
}
kretprobe:vring_interrupt
/@depth[cpu, tid, "vring_interrupt"] > 0/
{
  $d = @depth[cpu, tid, "vring_interrupt"];
  if (@start[cpu, tid, "vring_interrupt", $d]) {
    @us["vring_interrupt"] = hist((nsecs - @start[cpu, tid, "vring_interrupt", $d]) / 1000);
    delete(@start[cpu, tid, "vring_interrupt", $d]);
  }
  @depth[cpu, tid, "vring_interrupt"] = $d - 1;
  if ($d == 1) { delete(@depth[cpu, tid, "vring_interrupt"]); }
}
kprobe:net_rx_action
{
  @calls["net_rx_action"] = count();
  @depth[cpu, tid, "net_rx_action"] = @depth[cpu, tid, "net_rx_action"] + 1;
  @start[cpu, tid, "net_rx_action", @depth[cpu, tid, "net_rx_action"]] = nsecs;
}
kretprobe:net_rx_action
/@depth[cpu, tid, "net_rx_action"] > 0/
{
  $d = @depth[cpu, tid, "net_rx_action"];
  if (@start[cpu, tid, "net_rx_action", $d]) {
