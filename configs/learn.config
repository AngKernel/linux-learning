# 学习/调试用的 kconfig 片段，由 merge_config.sh 合并进 defconfig。
# 有些选项在不同版本上名字会变，merge 后 make olddefconfig 会自动收敛，
# 合并时的 "not in final" 警告多数可以忽略。

# --- 调试符号 / gdb ---
# 5.18 之后 DEBUG_INFO 变成 choice，要靠下面这个选项把它带出来
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_GDB_SCRIPTS=y
CONFIG_KGDB=y
CONFIG_DEBUG_KERNEL=y
CONFIG_FRAME_POINTER=y
CONFIG_KALLSYMS_ALL=y
CONFIG_MAGIC_SYSRQ=y

# --- 动态观测 ---
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_STACK_TRACER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# 下面这条需要宿主机装了 pahole(dwarves)，没装会编译失败，按需打开
# CONFIG_DEBUG_INFO_BTF=y

# --- 网络实验 ---
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_NETDEVSIM=m
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=m
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
CONFIG_XDP_SOCKETS=y

# --- 9p：把宿主机的 linux-learning 目录挂进虚拟机 /mnt ---
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# --- 模块 ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
