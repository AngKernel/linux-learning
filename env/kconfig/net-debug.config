# Linux v6.18 / x86_64；所有符号已逐项对照 Kconfig。
# defconfig + kernel/configs/kvm_guest.config 为基础；依赖校验由 build-kernel.sh 执行。
# 调试功能总开关
CONFIG_DEBUG_KERNEL=y
# 生成 DWARF 5，供 GDB 和 pahole 使用
CONFIG_DEBUG_INFO_DWARF5=y
# 关闭无调试信息选项
# CONFIG_DEBUG_INFO_NONE is not set
# 保留 BTF 需要的完整类型
# CONFIG_DEBUG_INFO_REDUCED is not set
# 避免 split DWARF 与 BTF 依赖冲突
# CONFIG_DEBUG_INFO_SPLIT is not set
# 生成 /sys/kernel/btf/vmlinux 的 BTF 类型信息
CONFIG_DEBUG_INFO_BTF=y
# 在输出目录生成 vmlinux-gdb.py 辅助脚本链接
CONFIG_GDB_SCRIPTS=y
# 运行时符号表
CONFIG_KALLSYMS=y
# 保留数据符号，便于调试
CONFIG_KALLSYMS_ALL=y
# 动态函数探针
CONFIG_KPROBES=y
# tracefs 的 kprobe 事件接口
CONFIG_KPROBE_EVENTS=y
# 内核 tracing 总开关
CONFIG_FTRACE=y
# 函数入口追踪
CONFIG_FUNCTION_TRACER=y
# 函数入口和返回的调用图
CONFIG_FUNCTION_GRAPH_TRACER=y
# 动态启停函数跟踪
CONFIG_DYNAMIC_FTRACE=y
# 用户态加载 BPF 程序；选择 BPF 核心
CONFIG_BPF_SYSCALL=y
# BPF 即时编译
CONFIG_BPF_JIT=y
# BPF 与 kprobe/tracepoint 集成
CONFIG_BPF_EVENTS=y
# perf 事件基础设施
CONFIG_PERF_EVENTS=y
# drop monitor netlink 支持；kfree_skb tracepoint 并不依赖它
CONFIG_NET_DROP_MONITOR=y
# 调试文件系统
CONFIG_DEBUG_FS=y
# 将构建配置嵌入内核
CONFIG_IKCONFIG=y
# 通过 /proc/config.gz 检查配置
CONFIG_IKCONFIG_PROC=y
# 调度统计支持，默认运行时开关另行控制
CONFIG_SCHEDSTATS=y
# x86 使用帧指针，便于 GDB 看栈
CONFIG_UNWINDER_FRAME_POINTER=y
# 与帧指针展开器互斥
# CONFIG_UNWINDER_ORC is not set
# 允许加载匹配此内核的模块
CONFIG_MODULES=y
# 允许卸载实验模块
CONFIG_MODULE_UNLOAD=y
# 内置 PCI virtio transport
CONFIG_VIRTIO_PCI=y
# 兼容 virtme 的 MMIO transport
CONFIG_VIRTIO_MMIO=y
# 内置 virtio_net 网卡
CONFIG_VIRTIO_NET=y
# 无需 initramfs 即可访问 virtio 系统盘
CONFIG_VIRTIO_BLK=y
# virtme 的 virtio 串口
CONFIG_VIRTIO_CONSOLE=y
# virtiofs 的依赖
CONFIG_FUSE_FS=y
# virtiofs 共享目录备用方案
CONFIG_VIRTIO_FS=y
# 9p 协议客户端
CONFIG_NET_9P=y
# 9p 的 virtio transport
CONFIG_NET_9P_VIRTIO=y
# 9p 共享目录和 virtme 根文件系统
CONFIG_9P_FS=y
# 内置 Debian cloud rootfs 所需文件系统
CONFIG_EXT4_FS=y
# 自动创建设备节点
CONFIG_DEVTMPFS=y
# 启动时挂载 /dev
CONFIG_DEVTMPFS_MOUNT=y
# /proc
CONFIG_PROC_FS=y
# /sys
CONFIG_SYSFS=y
# /run 等临时文件系统
CONFIG_TMPFS=y
# 临时文件 ACL
CONFIG_TMPFS_POSIX_ACL=y
# 临时文件扩展属性
CONFIG_TMPFS_XATTR=y
# virtme 临时可写覆盖层
CONFIG_OVERLAY_FS=y
# SSH 伪终端
CONFIG_UNIX98_PTYS=y
# systemd 文件句柄支持
CONFIG_FHANDLE=y
# systemd 使用的控制组
CONFIG_CGROUPS=y
# 用户态服务所需 namespace 支持
CONFIG_NAMESPACES=y
# tcpdump 的 packet socket
CONFIG_PACKET=y
# 用户态 Unix socket
CONFIG_UNIX=y
# IPv4/TCP/UDP
CONFIG_INET=y
# IPv6
CONFIG_IPV6=y
# 流量控制基础
CONFIG_NET_SCHED=y
# TCP pacing 可选 qdisc
CONFIG_NET_SCH_FQ=y
# 延迟和丢包实验
CONFIG_NET_SCH_NETEM=y
# 客户机中也可进行桥接实验
CONFIG_BRIDGE=y
# 客户机中 TAP/TUN 实验；不能代替宿主 TUN 支持
CONFIG_TUN=y
